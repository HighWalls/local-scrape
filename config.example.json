{
  "ollama_mode": "cloud",
  "ollama_url": "https://ollama.com",
  "model": "deepseek-v4.1-flash",
  "ollama_api_key_env": "OLLAMA_API_KEY",
  "credential_env_file": ".env",
  "api_host": "127.0.0.1",
  "api_port": 8765,
  "num_ctx": 8192,
  "max_input_chars": 18000,
  "max_response_bytes": 5000000,
  "timeout_seconds": 45,
  "ollama_timeout_seconds": 180,
  "allow_private_urls": false,
  "respect_robots": true,
  "max_pages": 20,
  "max_depth": 3,
  "crawl_deadline_seconds": 180,
  "search_max_results": 10,
  "monitor_poll_seconds": 10,
  "max_monitors": 100,
  "history_limit": 10000,
  "event_limit": 1000
}
